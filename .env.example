# GEMINI_API_KEY: Server-only key required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Server-Only Supabase Service Role Key (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Meta / Messaging Channel Integration (Server-Only Secrets)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"

